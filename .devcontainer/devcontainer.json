{
  "name": "LogWarden",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install -e '.[all]' && logwarden demo",
  "forwardPorts": [8501],
  "portsAttributes": { "8501": { "label": "LogWarden dashboard", "onAutoForward": "openBrowser" } },
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
